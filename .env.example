# Configuração de Telefone da Família para Notificações do WhatsApp (apenas números com DDD, ex: 5531999999999)
NEXT_PUBLIC_FAMILY_WHATSAPP_NUMBER=5531999999999

# Senha/PIN do Administrador para gerenciar visitas (cancelar, mudar horários)
NEXT_PUBLIC_ADMIN_PIN=1234

# Credenciais do Supabase (para ambiente Serverless na Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
